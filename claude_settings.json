# jq '.projects["/"] = ((.projects["/"] // {}) + {hasTrustDialogAccepted: true})' ~/.claude.json > /tmp/c.json && mv /tmp/c.json ~/.claude.json
{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(jq -r '(.last_assistant_message // \"Done\") | .[:200]' 2>/dev/null | tr ';' ','); [ -z \"$msg\" ] && msg=\"Done\"; printf '\\033]777;notify;Claude Code;%s\\033\\\\' \"$msg\" > /proc/$PPID/fd/1"
          }
        ]
      }
    ]
  }
}
